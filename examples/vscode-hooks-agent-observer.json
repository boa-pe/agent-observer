{
  "_comment": "VS Code agent hooks. Save as <project>/.github/hooks/agent-observer.json. Replace AGENT_ID and the host. `bash` runs on Linux/macOS, `powershell` on Windows (curl.exe, stdin via $input, always exit 0), `command` is the fallback. Do not use together with the Copilot CLI file in the same repository.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=SessionStart\" >/dev/null 2>&1 || true",
            "bash": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=SessionStart\" >/dev/null 2>&1 || true",
            "powershell": "$OutputEncoding=[Text.UTF8Encoding]::new($false); $input | curl.exe -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=SessionStart\" | Out-Null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
