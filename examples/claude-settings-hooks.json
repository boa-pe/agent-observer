{
  "_comment": "Claude Code. Merge the `hooks` object into ~/.claude/settings.json or <project>/.claude/settings.json. Replace AGENT_ID with the id configured in the web UI and the host with your device IP or agent-observer.local. All hooks are command hooks running curl via bash (Git Bash on Windows); they are silent and always exit 0. The web UI generates this for you (Connect an agent).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=SessionStart\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=UserPromptSubmit\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
