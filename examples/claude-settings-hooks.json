{
  "_comment": "Claude Code. Merge the `hooks` object into ~/.claude/settings.json or <project>/.claude/settings.json. Replace AGENT_ID with the id configured in the web UI and the host with your device IP or agent-observer.local. HTTP hooks need no shell or curl and behave the same on Windows, Linux and macOS; only SessionStart (command hooks only) runs curl via bash (Git Bash on Windows). The web UI generates this for you (Connect an agent) and can emit curl command hooks for all events instead.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=SessionStart\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=UserPromptSubmit",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=PreToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=PostToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=PermissionRequest",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=Notification",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=Stop",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=SubagentStop",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://agent-observer.local/api/hook/AGENT_ID?event=SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
