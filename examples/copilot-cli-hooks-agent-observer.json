{
  "_comment": "GitHub Copilot CLI hooks. Save as <repo>/.github/hooks/agent-observer.json. Replace AGENT_ID and the host. `bash` runs on Linux/macOS, `powershell` on Windows; both always exit 0 so an unreachable device never denies a tool call.",
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=sessionStart\" >/dev/null 2>&1 || true",
        "powershell": "$OutputEncoding=[Text.UTF8Encoding]::new($false); $input | curl.exe -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=sessionStart\" | Out-Null; exit 0",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "curl -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=userPromptSubmitted\" >/dev/null 2>&1 || true",
        "powershell": "$OutputEncoding=[Text.UTF8Encoding]::new($false); $input | curl.exe -s -m 2 --connect-timeout 1 -X POST -H \"Content-Type: application/json\" -H \"Expect:\" --data-binary \"@-\" \"http://agent-observer.local/api/hook/AGENT_ID?event=userPromptSubmitted\" | Out-Null; exit 0",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
