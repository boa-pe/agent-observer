# Example port: LILYGO T-Display (ESP32, ST7789 135x240, no RGB LED, button GPIO35 / GPIO0)
# Verify pins against your board revision before flashing.
CONFIG_AO_LCD_WIDTH=135
CONFIG_AO_LCD_HEIGHT=240
CONFIG_AO_LCD_PIN_MOSI=19
CONFIG_AO_LCD_PIN_SCLK=18
CONFIG_AO_LCD_PIN_CS=5
CONFIG_AO_LCD_PIN_DC=16
CONFIG_AO_LCD_PIN_RST=23
CONFIG_AO_LCD_PIN_BL=4
CONFIG_AO_LCD_X_GAP=52
CONFIG_AO_LCD_Y_GAP=40
CONFIG_AO_LCD_INVERT_COLOR=y
CONFIG_AO_LED_NONE=y
CONFIG_AO_BUTTON_GPIO=35
CONFIG_AO_BUTTON_ACTIVE_LOW=y
