# Waveshare ESP32-C6-LCD-1.47 (ST7789 172x320, WS2812 on GPIO8, BOOT button GPIO9)
# These equal the Kconfig defaults; listed explicitly for reference.
CONFIG_AO_LCD_WIDTH=172
CONFIG_AO_LCD_HEIGHT=320
CONFIG_AO_LCD_PIN_MOSI=6
CONFIG_AO_LCD_PIN_SCLK=7
CONFIG_AO_LCD_PIN_CS=14
CONFIG_AO_LCD_PIN_DC=15
CONFIG_AO_LCD_PIN_RST=21
CONFIG_AO_LCD_PIN_BL=22
CONFIG_AO_LCD_X_GAP=34
CONFIG_AO_LCD_Y_GAP=0
CONFIG_AO_LCD_INVERT_COLOR=y
CONFIG_AO_LED_WS2812=y
CONFIG_AO_LED_WS2812_GPIO=8
CONFIG_AO_LED_WS2812_ORDER_RGB=y
CONFIG_AO_BUTTON_GPIO=9
CONFIG_AO_BUTTON_ACTIVE_LOW=y
